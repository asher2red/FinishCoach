<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/coach_root" android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="vertical" android:padding="12dp" android:background="@drawable/finish_widget_background">
 <TextView android:id="@+id/coach_title" android:layout_width="match_parent" android:layout_height="wrap_content"
  android:minHeight="44dp" android:gravity="center_vertical" android:textSize="16sp" android:textStyle="bold"
  android:textColor="#000000" android:maxLines="1" android:ellipsize="end" android:text="@string/finish_widget_title" />
 <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
  <ListView android:id="@+id/coach_list" android:layout_width="match_parent" android:layout_height="match_parent"
   android:divider="@android:color/transparent" android:dividerHeight="0dp" android:scrollbars="vertical" />
  <TextView android:id="@+id/coach_empty" android:layout_width="match_parent" android:layout_height="match_parent"
   android:gravity="center_vertical" android:textSize="14sp" android:textColor="#000000" android:text="@string/finish_widget_stale" />
 </FrameLayout>
</LinearLayout>
