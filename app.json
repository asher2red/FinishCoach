{
  "expo": {
    "name": "Finish Coach",
    "slug": "finishCoach",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/app-icon-1024.png",
    "scheme": "finishcoach",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/brand/app-icon-1024.png",
      "bundleIdentifier": "com.finishcoach.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F8FC",
        "foregroundImage": "./assets/brand/adaptive-safe-1024.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.finishcoach.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F8FC",
          "image": "./assets/brand/coach-cap-small.png",
          "imageWidth": 96
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "eadf24e8-8761-4288-b1b7-58c3b47f2bc5"
      }
    }
  }
}
