  "dependencies": {
    "@expo/ui": "~58.0.20",
    "expo": "~58.0.14",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.8",
    "expo-glass-effect": "~58.0.4",
    "expo-image": "~58.0.15",
    "expo-linking": "~58.0.13",
    "expo-notifications": "~58.1.5",
    "expo-router": "~58.0.23",
    "expo-splash-screen": "~58.0.10",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.3",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-purchases": "^10.15.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "fake-indexeddb": "^6.2.6",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:web": "expo export --platform web",
    "test:e2e": "playwright test",
    "preview:web": "node scripts/serve-web.mjs",
    "format": "prettier --write src tests e2e docs *.json *.ts *.js",
    "build:native": "expo export --platform android --platform ios --output-dir dist-native",
    "doctor:local": "node scripts/local-build.mjs doctor",
    "build:android:local": "node scripts/local-build.mjs android",
    "build:ios:local": "node scripts/local-build.mjs ios",
    "build:ios:device:local": "node scripts/local-build.mjs ios-device",
    "run:android:local": "node scripts/local-build.mjs run-android",
    "run:ios:local": "node scripts/local-build.mjs run-ios"
  },
  "private": true
}
